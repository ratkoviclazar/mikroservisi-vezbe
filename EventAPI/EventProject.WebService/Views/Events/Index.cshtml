@model IEnumerable<EventViewModel>
@using EventProject.DTO.DTOs

@{
    ViewData["Title"] = "Događaji";
}
<h2 class="mb-4">Događaji</h2>
<a class="btn btn-primary mb-3" asp-action="Create">Novi događaj</a>

<form asp-action="Search" method="get" class="row g-2 mb-4">
    <div class="col-auto">
        <input type="text" name="name" value="@ViewBag.SearchName" class="form-control" placeholder="Naziv" />
    </div>
    <div class="col-auto">
        <select name="locationId" class="form-select">
            <option value="">-- Lokacija --</option>
            @foreach (var l in (ViewBag.Locations as IEnumerable<LocationDto>) ?? Enumerable.Empty<LocationDto>())
            {
                <option value="@l.Id" selected="@(ViewBag.SearchLocationId == l.Id)">@l.Name</option>
            }
        </select>
    </div>
    <div class="col-auto">
        <select name="typeId" class="form-select">
            <option value="">-- Tip --</option>
            @foreach (var t in (ViewBag.Types as IEnumerable<EventTypeDto>) ?? Enumerable.Empty<EventTypeDto>())
            {
                <option value="@t.Id" selected="@(ViewBag.SearchTypeId == t.Id)">@t.Name</option>
            }
        </select>
    </div>
    <div class="col-auto">
        <input type="date" name="from" value="@ViewBag.SearchFrom" class="form-control" />
    </div>
    <div class="col-auto">
        <input type="date" name="to" value="@ViewBag.SearchTo" class="form-control" />
    </div>
    <div class="col-auto">
        <button type="submit" class="btn btn-secondary">Pretraži</button>
        <a asp-action="Index" class="btn btn-outline-secondary">Resetuj</a>
    </div>
</form>

<table class="table table-bordered table-striped">
    <thead>
        <tr>
            <th>Naziv</th>
            <th>Agenda</th>
            <th>Datum i vreme</th>
            <th>Trajanje (h)</th>
            <th>Cena</th>
            <th>Lokacija</th>
            <th>Tip</th>
            <th>Akcije</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var d in Model)
        {
            <tr>
                <td>@d.Name</td>
                <td>@d.Agenda</td>
                <td>@d.DateTime.ToString("g")</td>
                <td>@d.DurationInHours</td>
                <td>@d.Price</td>
                <td>@d.LocationName</td>
                <td>@d.TypeName</td>
                <td>
                    <a class="btn btn-info btn-sm" asp-action="Details" asp-route-id="@d.Id">Detalji</a>
                    <a class="btn btn-warning btn-sm" asp-action="Edit" asp-route-id="@d.Id">Izmeni</a>
                    <a class="btn btn-danger btn-sm" asp-action="Delete" asp-route-id="@d.Id">Obriši</a>
                    <a class="btn btn-success btn-sm" asp-controller="EventLectures" asp-action="Index" asp-route-eventId="@d.Id" asp-route-eventName="@d.Name">Predavači</a>
                </td>
            </tr>
        }
    </tbody>
</table>